opp_name):\n","    \"\"\"\n","    Standard discount reduction simulation.\n","    Applies new_discount to masked rows, recalculates price and units.\n","    \"\"\"\n","    df_sim = df.copy()\n","\n","    old_final_price = df.loc[mask, COLS[\"final_price\"]].copy()\n","\n","    # Apply new discount\n","    df_sim.loc[mask, COLS[\"discount_percent\"]] = new_discount\n","    df_sim.loc[mask, COLS[\"final_price\"]] = (\n","        df_sim.loc[mask, COLS[\"base_price\"]] * (1 - new_discount / 100)\n","    )\n","\n","    # Price change as a percentage\n","    price_change_pct = (\n","        (df_sim.loc[mask, COLS[\"final_price\"]] - old_final_price)\n","        / old_final_price\n","    )\n","\n","    # Units adjust inversely to price change, scaled by elasticity\n","    df_sim.loc[mask, COLS[\"units_sold\"]] = (\n","        df.loc[mask, COLS[\"units_sold\"]] * (1 - elasticity * price_change_pct)\n","    ).clip(lower=0)  # units can't go negative\n","\n","    # Recalculate revenue\n","    df_sim.loc[mask, COLS[\"revenue\"]] = (\n","        df_sim.loc[mask, COLS[\"final_price\"]] * df_sim.loc[mask, COLS[\"units_sold\"]]\n","    )\n","\n","    return _build_result(df, df_sim, mask, opp_name, \"discount_change\")\n"],"metadata":{"id":"5wBD7VLLuM7O","executionInfo":{"status":"ok","timestamp":1779481397369,"user_tz":-120,"elapsed":10,"user":{"displayName":"Kgosigadi Nyepele","userId":"04390727676647877703"}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":["def simulate_volume_growth(df, mask, growth_pct, opp_name):\n","    \"\"\"\n","    Volume uplift simulation (no discount change).\n","    Used for geographic gap-closing (Opp 12).\n","    \"\"\"\n","    df_sim = df.copy()\n","\n","    df_sim.loc[mask, COLS[\"units_sold\"]] = (\n","        df.loc[mask, COLS[\"units_sold\"]] * (1 + growth_pct / 100)\n","    )\n","    df_sim.loc[mask, COLS[\"revenue\"]] = (\n","        df_sim.loc[mask, COLS[\"final_price\"]] * df_sim.loc[mask, COLS[\"units_sold\"]]\n","    )\n","\n","    return _build_result(df, df_sim, mask, opp_name, \"volume_growth\")"],"metadata":{"id":"7yAX0iUivHMe","executionInfo":{"status":"ok","timestamp":1779481397380,"user_tz":-120,"elapsed":7,"user":{"displayName":"Kgosigadi Nyepele","userId":"04390727676647877703"}}},"execution_count":4,"outputs":[]},{"cell_type":"code","source":["def simulate_reallocation(df, festival_mask, normal_mask,\n","                           festival_discount_reduction,\n","                           normal_discount_improvement,\n","                           festival_elasticity,\n","                           normal_elasticity,\n","                           opp_name):\n","    \"\"\"\n","    Two-sided reallocation simulation.\n","    Festival spend goes down; normal-period spend improves.\n","    Used for Opp 10.\n","    \"\"\"\n","    df_sim = df.copy()\n","\n","    # --- Festival side (discount rises = spend reduction) ---\n","    old_festival_price = df.loc[festival_mask, COLS[\"final_price\"]].copy()\n","    new_festival_discount = (\n","        df.loc[festival_mask, COLS[\"discount_percent\"]] - festival_discount_reduction\n","    ).clip(lower=0)\n","\n","    df_sim.loc[festival_mask, COLS[\"discount_percent\"]] = new_festival_discount\n","    df_sim.loc[festival_mask, COLS[\"final_price\"]] = (\n","        df_sim.loc[festival_mask, COLS[\"base_price\"]]\n","        * (1 - new_festival_discount / 100)\n","    )\n","\n","    price_change_festival = (\n","        (df_sim.loc[festival_mask, COLS[\"final_price\"]] - old_festival_price)\n","        / old_festival_price\n","    )\n","    df_sim.loc[festival_mask, COLS[\"units_sold\"]] = (\n","        df.loc[festival_mask, COLS[\"units_sold\"]]\n","        * (1 + festival_elasticity * price_change_festival)\n","    ).clip(lower=0)\n","\n","    df_sim.loc[festival_mask, COLS[\"revenue\"]] = (\n","        df_sim.loc[festival_mask, COLS[\"final_price\"]]\n","        * df_sim.loc[festival_mask, COLS[\"units_sold\"]]\n","    )\n","\n","    # --- Normal side (discount reduces slightly = organic uplift) ---\n","    old_normal_price = df.loc[normal_mask, COLS[\"final_price\"]].copy()\n","    new_normal_discount = (\n","        df.loc[normal_mask, COLS[\"discount_percent\"]] - normal_discount_improvement\n","    ).clip(lower=0)\n","\n","    df_sim.loc[normal_mask, COLS[\"discount_percent\"]] = new_normal_discount\n","    df_sim.loc[normal_mask, COLS[\"final_price\"]] = (\n","        df_sim.loc[normal_mask, COLS[\"base_price\"]]\n","        * (1 - new_normal_discount / 100)\n","    )\n","\n","    price_change_normal = (\n","        (df_sim.loc[normal_mask, COLS[\"final_price\"]] - old_normal_price)\n","        / old_normal_price\n","    )\n","    df_sim.loc[normal_mask, COLS[\"units_sold\"]] = (\n","        df.loc[normal_mask, COLS[\"units_sold\"]]\n","        * (1 + normal_elasticity * price_change_normal)\n","    ).clip(lower=0)\n","\n","    df_sim.loc[normal_mask, COLS[\"revenue\"]] = (\n","        df_sim.loc[normal_mask, COLS[\"final_price\"]]\n","        * df_sim.loc[normal_mask, COLS[\"units_sold\"]]\n","    )\n","\n","    combined_mask = festival_mask | normal_mask\n","    return _build_result(df, df_sim, combined_mask, opp_name, \"reallocation\")"],"metadata":{"id":"5jqRoNxfvnZX","executionInfo":{"status":"ok","timestamp":1779481397395,"user_tz":-120,"elapsed":10,"user":{"displayName":"Kgosigadi Nyepele","userId":"04390727676647877703"}}},"execution_count":5,"outputs":[]},{"cell_type":"code","source":["def _build_result(df, df_sim, mask, opp_name, sim_type):\n","    \"\"\"Assembles the result dict from actual vs simulated data.\"\"\"\n","    actual_total     = df[COLS[\"revenue\"]].sum()\n","    sim_total        = df_sim[COLS[\"revenue\"]].sum()\n","    actual_affected  = df.loc[mask, COLS[\"revenue\"]].sum()\n","    sim_affected     = df_sim.loc[mask, COLS[\"revenue\"]].sum()\n","    delta            = sim_total - actual_total\n","    delta_pct        = delta / actual_total * 100\n","\n","    actual_units     = df.loc[mask, COLS[\"units_sold\"]].sum()\n","    sim_units        = df_sim.loc[mask, COLS[\"units_sold\"]].sum()\n","    unit_delta       = sim_units - actual_units\n","    unit_delta_pct   = unit_delta / actual_units * 100 if actual_units > 0 else 0\n","\n","    # Calculate average discounts for affected rows\n","    if mask.sum() > 0:\n","        actual_discount_units_sold_sum = df.loc[mask, COLS[\"units_sold\"]].sum()\n","        sim_discount_units_sold_sum = df_sim.loc[mask, COLS[\"units_sold\"]].sum()\n","\n","        actual_discount = (df.loc[mask, COLS[\"discount_percent\"]] * df.loc[mask, COLS[\"units_sold\"]]).sum() / actual_discount_units_sold_sum if actual_discount_units_sold_sum > 0 else 0\n","        sim_discount = (df_sim.loc[mask, COLS[\"discount_percent\"]] * df_sim.loc[mask, COLS[\"units_sold\"]]).sum() / sim_discount_units_sold_sum if sim_discount_units_sold_sum > 0 else 0\n","    else:\n","        actual_discount = 0\n","        sim_discount = 0\n","\n","    return {\n","        \"opportunity\":              opp_name,\n","        \"sim_type\":                 sim_type,\n","        \"rows_affected\":            int(mask.sum()),\n","        \"actual_revenue_total\":     round(actual_total, 2),\n","        \"simulated_revenue_total\":  round(sim_total, 2),\n","        \"revenue_delta\":            round(delta, 2),\n","        \"revenue_delta_pct\":        round(delta_pct, 4),\n","        \"actual_revenue_affected\":  round(actual_affected, 2),\n","        \"sim_revenue_affected\":     round(sim_affected, 2),\n","        \"actual_units_affected\":    round(actual_units, 2),\n","        \"sim_units_affected\":       round(sim_units, 2),\n","        \"unit_delta\":               round(unit_delta, 2),\n","        \"unit_delta_pct\":           round(unit_delta_pct, 4),\n","        \"avg_discount_before\":      round(actual_discount, 2),\n","        \"avg_discount_after\":       round(sim_discount, 2),\n","    }"],"metadata":{"id":"ekFbBvdBwMhg","executionInfo":{"status":"ok","timestamp":1779481397412,"user_tz":-120,"elapsed":7,"user":{"displayName":"Kgosigadi Nyepele","userId":"04390727676647877703"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["def run_all_opportunities(df):\n","    # --- Calculate data-driven optimal discount from 31-40% band ---\n","    optimal_discount = (\n","        df[df[COLS[\"discount_bracket\"]] == \"30-40%\"]\n","        .groupby(COLS[\"discount_percent\"])[COLS[\"revenue\"]]\n","        .sum()\n","        .idxmax()\n","    )\n","    print(f\"Data-driven optimal discount: {optimal_discount}%\")\n","\n","    results = []\n","    # ------------------------------------------------------------------\n","    # OPP 1: Mass brand discount cap at 40%\n","    # ------------------------------------------------------------------\n","    for target in [40, 38, 35, round(optimal_discount)]:\n","        mask = (\n","            (df[COLS[\"brand_type\"]] == \"Mass\") &\n","            (df[COLS[\"discount_percent\"]] > 40)\n","        )\n","        results.append(simulate_discount_change(\n","            df, mask,\n","            new_discount=target,\n","            elasticity=0.8,\n","            opp_name=f\"OPP_01: Mass Brand Cap at {target}%\"\n","        ))\n","\n","    # ------------------------------------------------------------------\n","    # OPP 2: Electronics (Mass) into 31-40% optimal band\n","    # ------------------------------------------------------------------\n","    for target in [40, 38, 35, round(optimal_discount)]:\n","      mask = (\n","          (df[COLS[\"category\"]] == \"Electronics\") &\n","          (df[COLS[\"brand_type\"]] == \"Mass\") &\n","          (df[COLS[\"discount_percent\"]] > 40)\n","      )\n","      results.append(simulate_discount_change(\n","          df, mask,\n","          new_discount=target,\n","          elasticity=0.8,\n","          opp_name=f\"OPP_02: Electronics Mass Cap at {target}%\"\n","      ))\n","\n","    # ------------------------------------------------------------------\n","    # OPP 3: Shift 61-70% band into 31-40% band\n","    # ------------------------------------------------------------------\n","    for target in [40, 38, 35, round(optimal_discount)]:\n","      mask = (\n","          (df[COLS[\"discount_bracket\"]].isin([\"40%+\"])) &\n","          (df[COLS[\"discount_percent\"]] > target)\n","      )\n","      results.append(simulate_discount_change(\n","          df, mask,\n","          new_discount=target,\n","          elasticity=0.8,\n","          opp_name=f\"OPP_03: Deep Bands Cap at {target}%\"\n","      ))\n","\n","    # ------------------------------------------------------------------\n","    # OPP 4: Remove festival discounting — Premium Lifestyle & Electronics\n","    # ------------------------------------------------------------------\n","    categories_4 = [\"Premium Lifestyle\", \"Electronics\"]\n","    festival_mask = (\n","        (df[COLS[\"sales_event\"]] == \"Festival\") &\n","        (df[COLS[\"category\"]].isin(categories_4))\n","    )\n","    # Baseline: average discount for same categories in normal periods\n","    for cat in categories_4:\n","        normal_avg = (\n","            df.loc[\n","                (df[COLS[\"sales_event\"]] == \"Normal\") &\n","                (df[COLS[\"category\"]] == cat),\n","                COLS[\"discount_percent\"]\n","            ] *\n","            df.loc[\n","                (df[COLS[\"sales_event\"]] == \"Normal\") &\n","                (df[COLS[\"category\"]] == cat),\n","                COLS[\"units_sold\"]\n","            ]\n","        ).sum() / df.loc[\n","            (df[COLS[\"sales_event\"]] == \"Normal\") &\n","            (df[COLS[\"category\"]] == cat),\n","            COLS[\"units_sold\"]\n","        ].sum()\n","        cat_mask = festival_mask & (df[COLS[\"category\"]] == cat)\n","        # Run each category with its own normal-period baseline\n","        results.append(simulate_discount_change(\n","            df, cat_mask,\n","            new_discount=round(normal_avg, 1),\n","            elasticity=0.3,\n","            opp_name=f\"OPP_04: No Festival Discount — {cat}\"\n","        ))\n","\n","    # ------------------------------------------------------------------\n","    # OPP 5: Elderly & Middle-Aged toward full price (gradual, 3 steps)\n","    # ------------------------------------------------------------------\n","    age_groups = [\"Elderly\", \"Middle Age\"]\n","    for target_discount, step_label in [(30, \"Step 1\"), (25, \"Step 2\"), (20, \"Step 3\")]:\n","        mask = (\n","            (df[COLS[\"customer_age_group\"]].isin(age_groups)) &\n","            (df[COLS[\"discount_percent\"]] > target_discount)\n","        )\n","        results.append(simulate_discount_change(\n","            df, mask,\n","            new_discount=target_discount,\n","            elasticity=0.2,\n","            opp_name=f\"OPP_05: Age Low-Sensitivity to {target_discount}% ({step_label})\"\n","        ))\n","\n","    # ------------------------------------------------------------------\n","    # OPP 6: Premium brand discounts held at or below 30%\n","    # ------------------------------------------------------------------\n","    mask = (\n","        (df[COLS[\"brand_type\"]] == \"Premium\") &\n","        (df[COLS[\"discount_percent\"]] > 30)\n","    )\n","    results.append(simulate_discount_change(\n","        df, mask,\n","        new_discount=30,\n","        elasticity=0.3,\n","        opp_name=\"OPP_06: Premium Brand Cap at 30%\"\n","    ))\n","\n","    # ------------------------------------------------------------------\n","    # OPP 7: Inventory-driven markdowns capped at 40%\n","    # ------------------------------------------------------------------\n","    mask = (\n","        (df[COLS[\"inventory_pressure\"]] == \"High\") &\n","        (df[COLS[\"discount_percent\"]] > 40)\n","    )\n","    results.append(simulate_discount_change(\n","        df, mask,\n","        new_discount=40,\n","        elasticity=0.6,\n","        opp_name=\"OPP_07: Inventory Markdown Cap at 40%\"\n","    ))\n","\n","    # ------------------------------------------------------------------\n","    # OPP 8: Remove triple-risk combination\n","    # ------------------------------------------------------------------\n","    triple_risk_brackets = [\"40%+\"] # Corrected label\n","\n","    # What do these category/brand combos discount at under normal conditions?\n","    calm_mask = (\n","    (df[COLS[\"sales_event\"]] == \"Normal\") &\n","    (df[COLS[\"competition_intensity\"]] != \"High\")\n","    )\n","\n","    calm_avg = (\n","        (df.loc[calm_mask, COLS[\"discount_percent\"]] * df.loc[calm_mask, COLS[\"units_sold\"]]).sum()\n","        / df.loc[calm_mask, COLS[\"units_sold\"]].sum()\n","    )\n","\n","    print(f\"Calm-period weighted avg discount: {calm_avg:.1f}%\")\n","\n","    mask = (\n","        (df[COLS[\"sales_event\"]] == \"Festival\") &\n","        (df[COLS[\"competition_intensity\"]] == \"High\") &\n","        (df[COLS[\"discount_bracket\"]].isin(triple_risk_brackets)) # Corrected label\n","    )\n","    results.append(simulate_discount_change(\n","        df, mask,\n","        new_discount=round(calm_avg, 2),\n","        elasticity=0.65,\n","        opp_name=\"OPP_08: Remove Triple-Risk Combination\"\n","    ))\n","\n","    # ------------------------------------------------------------------\n","    # OPP 9: Price-inelastic segments to optimal band\n","    # ------------------------------------------------------------------\n","    inelastic_cats = [\"Home & Living\", \"Footwear\", \"Premium Lifestyle\"]\n","    mask = (\n","        (df[COLS[\"category\"]].isin(inelastic_cats)) &\n","        (df[COLS[\"discount_percent\"]] > 40)\n","    )\n","    results.append(simulate_discount_change(\n","        df, mask,\n","        new_discount=optimal_discount,\n","        elasticity=0.2,\n","        opp_name=\"OPP_09: Inelastic Segments to Optimal Discount\"\n","    ))\n","\n","    # ------------------------------------------------------------------\n","    # OPP 10: Reallocate festival spend to normal periods\n","    # ------------------------------------------------------------------\n","    festival_mask_10 = (df[COLS[\"sales_event\"]] == \"Festival\")\n","    normal_mask_10   = (df[COLS[\"sales_event\"]] == \"Normal\")\n","    results.append(simulate_reallocation(\n","        df,\n","        festival_mask=festival_mask_10,\n","        normal_mask=normal_mask_10,\n","        festival_discount_reduction=10,   # reduce festival discount by 10pp\n","        normal_discount_improvement=3,    # improve normal-period pricing by 3pp\n","        festival_elasticity=0.5,\n","        normal_elasticity=0.3,\n","        opp_name=\"OPP_10: Reallocate Festival Spend to Normal Periods\"\n","    ))\n","\n","    # ------------------------------------------------------------------\n","    # OPP 11: Grocery Essentials — recover over-discounting\n","    # Breakeven sweep: find where revenue stops improving\n","    # ------------------------------------------------------------------\n","    grocery_mask = (\n","        (df[COLS[\"category\"]] == \"Grocery Essentials\") &\n","        (df[COLS[\"discount_percent\"]] > 25)\n","    )\n","    for target in [25, 22, 20]:\n","        results.append(simulate_discount_change(\n","            df, grocery_mask,\n","            new_discount=target,\n","            elasticity=0.9,\n","            opp_name=f\"OPP_11: Grocery Essentials to {target}%\"\n","        ))\n","\n","    # ------------------------------------------------------------------\n","    # OPP 12: Lower-tier states close revenue gap (volume model)\n","    # ------------------------------------------------------------------\n","    lower_tier_states = [\"Uttar Pradesh\", \"West Bengal\", \"Odisha\"]\n","    mask = df[COLS[\"state\"]].isin(lower_tier_states)\n","    for growth in [10, 20, 30]:\n","        results